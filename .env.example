PORT=5000
NODE_ENV=development

# Supabase Auth & Backend Verification (Phase 1)
# Find these in your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_SERVICE_ROLE_KEY is used by the backend to securely verify tokens and access admin functions.
# NEVER expose this key to the browser or commit real secrets to Git.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Comma-separated list of admin emails authorized for admin routes
ADMIN_EMAILS=admin@ghajanas.com,owner@ghajanas.com

# Store Owner WhatsApp Number (International format without '+' e.g. 916382240715)
OWNER_PHONE_NUMBER=916382240715

# Phase 2 Database (Prisma + PostgreSQL)
# DATABASE_URL="postgresql://user:password@localhost:5432/ghajanas?schema=public"
